{
  "name": "ordiff",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:core && npm run test:ui",
    "mcp": "node server/mcp.js",
    "typecheck": "tsc --noEmit",
    "test:core": "tsx --test tests/*.test.js",
    "test:ui": "vitest run",
    "desktop:prepare": "npm run build && node scripts/desktop-prepare.mjs",
    "desktop:dev": "npm run desktop:prepare && tauri dev --no-watch",
    "desktop:build": "tauri build",
    "desktop:install": "node scripts/desktop-install.mjs",
    "desktop:verify": "node --test tests/packaged-desktop.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@tauri-apps/api": "^2.12.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "exceljs": "^4.4.0",
    "lowlight": "^3.3.0",
    "mammoth": "^1.13.0",
    "mdast-util-from-markdown": "^2.1.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-pdf": "^11.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "word-extractor": "^1.0.4",
    "zod": "^4.6.7"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
