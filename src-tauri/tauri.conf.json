{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ordiff",
  "version": "0.3.0",
  "identifier": "local.ordiff.desktop",
  "build": {
    "frontendDist": "./bootstrap",
    "beforeBuildCommand": "npm run build && node scripts/desktop-prepare.mjs"
  },
  "app": {
    "windows": [],
    "security": { "capabilities": ["repository-picker"] }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/node"],
    "resources": { "resources/": "runtime/" },
    "macOS": { "minimumSystemVersion": "14.0", "signingIdentity": "-", "entitlements": "Entitlements.plist" }
  }
}
